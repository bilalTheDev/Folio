# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=

# --- MongoDB (local: the instance MongoDB Compass connects to) ---
MONGODB_URI=
MONGODB_DB_NAME=

# --- Auth (JWT) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
REFRESH_COOKIE_NAME=
COOKIE_SECURE=
COOKIE_SAMESITE=

# --- HF token encryption (Fernet key) ---
ENCRYPTION_KEY=

# --- CORS: exactly one origin, the Next.js app ---
CORS_ORIGIN=

# --- Storage / uploads ---
STORAGE_DIR=
MAX_UPLOAD_BYTES=

# --- RAG ---
EMBED_MODEL=
CHUNK_SIZE=
CHUNK_OVERLAP=
RETRIEVAL_TOP_K=

# --- Inference (Hugging Face Inference Providers router) ---
HF_ROUTER_BASE_URL=
LLM_TIMEOUT_SECONDS=

# --- Rate limits (Phase 10) ---
RATE_LIMIT_AUTH=
RATE_LIMIT_UPLOAD=
RATE_LIMIT_CHAT=
