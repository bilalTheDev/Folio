# Copy to .env and fill in. Never commit .env.
# Generate JWT_SECRET and JWT_REFRESH_SECRET (run twice, different values):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- App ---
APP_ENV=development

# --- MongoDB (local: the instance MongoDB Compass connects to) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=folio

# --- Auth (JWT) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=folio_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Provider-token encryption (Fernet key). Secret. ---
ENCRYPTION_KEY=

# --- CORS: exactly one origin, the Next.js app ---
CORS_ORIGIN=http://localhost:3000

# --- Storage / uploads ---
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760

# --- RAG (local FastEmbed; no API key required) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_LEAF_PROSE=512
CHUNK_PARENT_PROSE=2048
CHUNK_LEAF_STRUCTURED=256
CHUNK_PARENT_STRUCTURED=1024
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RERANK_ENABLED=true

# --- Hugging Face Inference Providers router (only if the user picks HF in the app) ---
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
LLM_TIMEOUT_SECONDS=60

# --- Rate limits ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CHAT=30/minute
