# Neon Postgres connection string (pooled for serverless)
DATABASE_URL=

# Clerk secret key for backend JWT verification
CLERK_SECRET_KEY=

# Clerk publishable key for the Next.js frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk JWKS URL for validating session tokens
CLERK_JWKS_URL=

# 32-byte AES-256 master key, base64-encoded, for remembered provider keys
FOLIO_ENCRYPTION_KEY=

# Sentry DSN for error monitoring (optional)
SENTRY_DSN=

# Set to true to disable the public sample-document trial
FOLIO_DISABLE_TRIAL=

# Runtime environment: development enables OpenAPI docs
FOLIO_ENV=development

# Allowed CORS origin for the frontend app
FOLIO_CORS_ORIGIN=http://localhost:3000

# Maximum upload size in megabytes
MAX_FILE_MB=10

# Maximum pages per document
MAX_PAGES=100

# Maximum documents per user
MAX_DOCUMENTS_PER_USER=20

# Maximum questions per user per day
DAILY_QUESTION_LIMIT=200

# Maximum uploads per user per hour
UPLOADS_PER_HOUR=10
